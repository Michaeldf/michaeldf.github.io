---
import Base from '../layouts/Base.astro';
const projects = [
  {
    name: 'TTLabs.no',
    description: 'My live project website. Find out more about it and see what I’m building.',
    status: 'Live',
    statusType: 'live',
    href: '/projects/ttlabs/',
  },
  {
    name: 'Furrow and Crown',
    description: 'A private project in its early stages. I’ll share more as it takes shape.',
    status: 'Early development · Private',
    statusType: 'private',
    href: '/projects/furrow-and-crown/',
  },
];
---
<Base title="Work" active="/">
  <section class="hero">
    <h1 class="reveal">Hi, I&rsquo;m <span class="grad">Michael</span></h1>
    <p class="reveal" style="--d:.15s">A personal portfolio sharing the projects I’m building, what stage they’re at, and where to find them.</p>
    <div class="reveal" style="--d:.3s">
      <a class="btn" href="https://github.com/Michaeldf?tab=repositories" target="_blank" rel="noopener noreferrer">Explore my GitHub repositories ↗</a>
      <a class="btn alt" href="/cv/">View my CV</a>
      <a class="btn alt" href="/about/">About me</a>
    </div>
  </section>
  <h2 class="reveal">Current projects</h2>
  <div class="grid">
    {projects.map((p, i) => (
      <a class="card project-card reveal" style={`--d:${i * 0.12}s`} href={p.href}>
        <div class="project-heading">
          <h3>{p.name}</h3>
          <span class:list={['status', `status-${p.statusType}`]}>{p.status}</span>
        </div>
        <p>{p.description}</p>
        <span class="project-more">Learn more →</span>
      </a>
    ))}
  </div>
</Base>

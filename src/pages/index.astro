---
import Base from '../layouts/Base.astro';
import Landscape from '../components/Landscape.astro';
import NoteList from '../components/NoteList.astro';
import { notes } from '../data/notes';
---
<Base title="Work" active="/" home>
<div class="night-hero">
<div class="hero-copy"><div class="eyebrow"><span class="dot"></span> A PERSONAL CORNER OF THE INTERNET</div><h1>Ideas become<br>things <em>here.</em></h1><p>I’m Michael. This is where I share what I’m<br class="desktop"> building, exploring, and figuring out along the way.</p><a class="main-action" href="#work">Explore my work <span aria-hidden="true">↓</span></a><button type="button" class="motion" aria-label="Pause ambient motion" aria-pressed="true" hidden>Pause motion <span>Ⅱ</span></button></div>
<Landscape />
<div class="hero-foot"><span>INDEPENDENT PROJECTS & ONGOING EXPERIMENTS</span><span>SCROLL TO EXPLORE ↓</span></div>
</div>
<div class="work-section" id="work"><div class="section-head"><h2>Selected work<span> / 02</span></h2><a href="https://github.com/Michaeldf?tab=repositories">All repositories ↗</a></div>
<div class="project-grid">
<a class="project" href="/projects/ttlabs/"><div class="project-art lab-art"><img src="/images/ttlabs-screenshot.jpg" alt="ttlabs.no homepage showing its table-tennis equipment finder" width="1280" height="720" loading="lazy" decoding="async" /></div><div class="project-info"><div><span class="project-tag"><span class="dot"></span> LIVE WEBSITE</span><h3>ttlabs.no</h3></div><span class="project-arrow">↗</span></div><p>Clearer data and practical comparisons for table-tennis rubbers and blades.</p></a>
<a class="project" href="/projects/furrow-and-crown/"><div class="project-art crown-art"><img src="/images/furrow-and-crown-concept.jpg" alt="Furrow and Crown concept art: a medieval village inn, cultivated fields, and a distant castle at dusk" width="1672" height="941" loading="lazy" decoding="async" /><span class="concept-label">CONCEPT ART</span></div><div class="project-info"><div><span class="project-tag">IN DEVELOPMENT · PRIVATE</span><h3>Furrow and Crown</h3></div><span class="project-arrow">↗</span></div><p>A medieval life simulation connecting ordinary livelihoods with households, dynasties, and power.</p></a>
</div></div>
<section class="home-notes"><div class="section-head"><h2>From the notebook</h2><a href="/notes/">All notes ↗</a></div><NoteList notes={notes.slice(0, 2)} /></section>
<div class="about-section" id="about"><span class="eyebrow">BEHIND THE PROJECTS</span><h2>Curiosity is the starting point.<br> Building is how I follow it.</h2><a href="/about/">More about me ↗</a></div>
</Base>

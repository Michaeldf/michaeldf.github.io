---
import Base from '../layouts/Base.astro';
const projects = [
  { name: 'Project One', tags: ['Tech', 'Tools'] },
  { name: 'Project Two', tags: ['Tech', 'Tools'] },
  { name: 'Project Three', tags: ['Tech', 'Tools'] },
];
---
<Base title="Work" active="/">
  <section class="hero">
    <h1 class="reveal">Hi, I&rsquo;m <span class="grad">Michael</span></h1>
    <p class="reveal" style="--d:.15s">[Your job title] &mdash; I build [what you do] that [value you bring].</p>
    <div class="reveal" style="--d:.3s">
      <a class="btn" href="/cv/">View my CV</a>
      <a class="btn alt" href="/about/">About me</a>
    </div>
  </section>
  <h2 class="reveal">Selected Work</h2>
  <div class="grid">
    {projects.map((p, i) => (
      <article class="card reveal" style={`--d:${i * 0.12}s`}>
        <h3>{p.name}</h3>
        <p>Short description: the problem, what you did, and the result.</p>
        {p.tags.map((t) => <span class="tag">{t}</span>)}
        <p><a href="#">View project &rarr;</a></p>
      </article>
    ))}
  </div>
</Base>

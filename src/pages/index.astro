---
import Base from '../layouts/Base.astro';
const projects = [
  {
    name: 'TTLabs.no',
    description: 'My live project website. Visit the site to see what I’m working on there.',
    status: 'Live',
    href: 'https://ttlabs.no/',
  },
  {
    name: 'Furrow and Crown',
    description: 'A private project in the very early stages of development. I’ll share more as it takes shape.',
    status: 'Early development · Private',
  },
];
---
<Base title="Work" active="/">
  <section class="hero">
    <h1 class="reveal">Hi, I&rsquo;m <span class="grad">Michael</span></h1>
    <p class="reveal" style="--d:.15s">A personal portfolio sharing the projects I’m building, what stage they’re at, and where to find them.</p>
    <div class="reveal" style="--d:.3s">
      <a class="btn" href="/cv/">View my CV</a>
      <a class="btn alt" href="/about/">About me</a>
    </div>
  </section>
  <h2 class="reveal">Current projects</h2>
  <div class="grid">
    {projects.map((p, i) => (
      <article class="card reveal" style={`--d:${i * 0.12}s`}>
        <div class="project-heading">
          <h3>{p.name}</h3>
          <span class:list={['status', p.href ? 'status-live' : 'status-private']}>{p.status}</span>
        </div>
        <p>{p.description}</p>
        {p.href && <p><a href={p.href} target="_blank" rel="noopener noreferrer">Visit TTLabs.no ↗</a></p>}
      </article>
    ))}
  </div>
</Base>

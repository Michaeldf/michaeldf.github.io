---
import Base from '../layouts/Base.astro';
---
<Base title="CV" active="/cv/">
  <h2 class="reveal">Curriculum Vitae</h2>
  <p class="reveal"><a class="btn" href="/cv.pdf">Download PDF</a></p>
  <h2 class="reveal">Experience</h2>
  <div class="timeline">
    <div class="job reveal"><strong>Job Title</strong>, Company<div class="meta">2022 &ndash; Present</div><ul><li>Key achievement with measurable result.</li><li>Another responsibility or achievement.</li></ul></div>
    <div class="job reveal"><strong>Previous Job Title</strong>, Company<div class="meta">2019 &ndash; 2022</div><ul><li>Key achievement with measurable result.</li></ul></div>
  </div>
  <h2 class="reveal">Education</h2>
  <div class="timeline"><div class="job reveal"><strong>Degree</strong>, University<div class="meta">2015 &ndash; 2019</div></div></div>
  <h2 class="reveal">Skills</h2>
  <p class="reveal"><span class="tag">Skill 1</span><span class="tag">Skill 2</span><span class="tag">Skill 3</span></p>
</Base>

---
import '../styles/global.css';
const { title, active } = Astro.props;
const links = [['/', 'Work'], ['/about/', 'About'], ['/cv/', 'CV'], ['https://github.com/Michaeldf?tab=repositories', 'GitHub repos', 'external']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfolio of Michael: work, about me and CV." />
    <title>{title} | Michael</title>
  </head>
  <body>
    <div class="world-scene" aria-hidden="true">
      <div class="sun-rays"></div>
      <div class="sun"></div>
      <div class="cloud cloud-one"></div>
      <div class="cloud cloud-two"></div>
      <div class="far-hills"></div>
      <div class="forest"><span></span><span></span><span></span><span></span><span></span></div>
      <div class="water"><div class="water-reflection"></div></div>
      <div class="voxel-ground"><div class="grass-line"></div></div>
    </div>
    <header>
      <nav>
        <a class="brand" href="/">Michael</a>
        <ul>
          {links.map(([href, label, external]) => (
            <li><a
              href={href}
              class:list={[active === href && 'active', external && 'btn']}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main><slot /></main>
    <footer>&copy; {new Date().getFullYear()} Michael · <a href="https://github.com/Michaeldf?tab=repositories">GitHub repositories</a></footer>
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
